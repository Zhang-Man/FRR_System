# ---- 复制为 .env 并按需修改 ----
# 企业/机构名称（用于品牌展示等场景）
ORG_NAME=你的企业名称

# JWT 签名密钥（生产环境务必修改为随机长字符串）
SECRET_KEY=change-me-to-a-random-secret

# SQLite 数据库路径（相对 backend 运行目录或绝对路径）
DB_PATH=backend/data.db

# 允许的跨域来源，逗号分隔；* 表示全部
CORS_ORIGINS=*

# 日志级别 DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# 日志保留份数
LOG_BACKUP_COUNT=30

# 是否开启 Flask 调试模式（生产务必 false）
FLASK_DEBUG=false

# 默认管理员账号（首次启动 seed 时创建）
ADMIN_USER_ID=FrrSystemAdmin